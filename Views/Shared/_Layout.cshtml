@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isLibrary = controller == "Jogos" && action == "Index" || controller == "Home" && action == "Index";
    var isCreate = controller == "Jogos" && action == "Create";
    var jogosActions = MvcActions.ActionDescriptors.Items.OfType<Microsoft.AspNetCore.Mvc.Controllers.ControllerActionDescriptor>().Where(item => item.ControllerName == "Jogos");
    var hasLibrary = jogosActions.Any(item => item.ActionName == "Index");
    var hasCreate = jogosActions.Any(item => item.ActionName == "Create");
    var libraryUrl = Url.Action("Index", hasLibrary ? "Jogos" : "Home");
}
<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B1120" />
    <meta name="description" content="GameVault: um espaço para organizar e gerenciar sua biblioteca de jogos." />
    <title>@ViewData["Title"] · GameVault</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-sm container vault-container" aria-label="Navegação principal">
            <a class="brand" href="@libraryUrl" aria-label="GameVault, início">
                <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M6 6h12l3 12-3 1-4-4h-4l-4 4-3-1L6 6Z"/><path d="M7 10v4m-2-2h4m6-1h.01M18 13h.01"/></svg></span>
                Game<span class="brand-accent">Vault</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Abrir menu"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
            <div class="collapse navbar-collapse" id="main-navigation">
                <div class="nav-links">
                    <a class="vault-nav-link @(isLibrary ? "active" : "")" href="@libraryUrl" aria-current="@(isLibrary ? "page" : null)"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>Biblioteca</a>
                    @if (hasCreate)
                    {
                        <a class="vault-nav-link @(isCreate ? "active" : "")" asp-controller="Jogos" asp-action="Create" aria-current="@(isCreate ? "page" : null)">Adicionar jogo</a>
                    }
                </div>
                <span class="nav-caption">Sua coleção. Seu universo.</span>
            </div>
        </nav>
    </header>
    <main id="conteudo" class="container vault-container main-content" tabindex="-1">@RenderBody()</main>
    <footer class="site-footer"><div class="container vault-container footer-content"><span><strong>GameVault</strong><span class="footer-separator" aria-hidden="true">/</span>Todo jogo tem seu lugar.</span><span>ASP.NET Core MVC <span class="footer-separator" aria-hidden="true">·</span> @DateTime.Now.Year</span></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
