@model JogoModel
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<div class="form-field">
    <label asp-for="Nome">Nome do jogo</label>
    <input asp-for="Nome" class="form-control" placeholder="Como se chama a próxima aventura?" aria-describedby="Nome-error" />
    <span asp-validation-for="Nome" id="Nome-error" class="field-error"></span>
</div>
<div class="form-field">
    <label asp-for="Genero"></label>
    <select asp-for="Genero" asp-items='Html.GetEnumSelectList<GeneroEnum>().Where(item => item.Value != "-1")' class="form-control" aria-describedby="Genero-error">
        <option value="-1">Selecione um gênero</option>
    </select>
    <span asp-validation-for="Genero" id="Genero-error" class="field-error"></span>
</div>
<div class="form-grid">
    <div class="form-field">
        <label asp-for="Preco">Preço</label>
        <div class="currency-input"><span aria-hidden="true">R$</span><input asp-for="Preco" asp-format="{0:0.00}" type="number" step="0.01" class="form-control" aria-describedby="Preco-hint Preco-error" /></div>
        <span id="Preco-hint" class="field-hint">Valor em reais.</span>
        <span asp-validation-for="Preco" id="Preco-error" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="DataLancamento">Data de lançamento</label>
        <input asp-for="DataLancamento" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" aria-describedby="DataLancamento-error" />
        <span asp-validation-for="DataLancamento" id="DataLancamento-error" class="field-error"></span>
    </div>
</div>
